{
  "compilerOptions": {
    "target": "es5",                         
    "module": "commonjs",                    
    "declaration": true,                     
    "outDir": "./dist",                      
    "strict": true,                          
    "esModuleInterop": true,                 
    "allowSyntheticDefaultImports": true,    
    "moduleResolution": "node",              
    "resolveJsonModule": true,               
    "forceConsistentCasingInFileNames": true 
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
